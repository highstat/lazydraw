{
  "name": "@highstat/lazydraw",
  "version": "0.2.0",
  "description": "lazydraw is a terminal ASCII editor for drawing quick diagrams and sketches",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "highstat (https://github.com/highstat)",
  "homepage": "https://github.com/highstat/lazydraw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/highstat/lazydraw.git"
  },
  "bugs": {
    "url": "https://github.com/highstat/lazydraw/issues"
  },
  "keywords": [
    "ascii",
    "ascii-art",
    "asciiflow",
    "diagram",
    "terminal",
    "tui",
    "cli",
    "editor",
    "opentui"
  ],
  "bin": {
    "lazydraw": "src/cli.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "fixtures": "bun scripts/capture-fixtures.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/lazydraw",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@resvg/resvg-js": "^2.6.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
